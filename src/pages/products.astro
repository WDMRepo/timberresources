---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import Photo from '../components/Photo.astro';
import pineStand from '../assets/images/pine-stand.webp';
import pallets from '../assets/images/pallets.webp';
import liftTruck from '../assets/images/lift-truck-green-lumber.webp';

const palletSpecs = [
  ['Boards', '1x4 – 1x12, cut-to-length'],
  ['Dimension & cants', '2x4 – 2x12, low-grade and industrial'],
  ['Reman boards', 'Resawn from green plywood-mill timbers'],
  ['Processing', 'Resaw, cut-to-length, banding groove, S4S'],
];

// [category, nominal, thickness (in), width (in), std. pack (pcs) | null, lengths (ft)]
const sizes: [string, string, number, number, number | null, string][] = [
  ['Boards', '1x4', 0.75, 3.5, 384, '2–16'],
  ['Boards', '1x6', 0.75, 5.5, 256, '2–16'],
  ['Boards', '1x8', 0.75, 7.25, 192, '2–16'],
  ['Boards', '1x10', 0.75, 9.25, 160, '2–16'],
  ['Boards', '1x12', 0.75, 11.25, 128, '2–16'],
  ['Dimension', '2x4', 1.5, 3.5, 208, '2–20'],
  ['Dimension', '2x6', 1.5, 5.5, 128, '2–20'],
  ['Dimension', '2x8', 1.5, 7.25, 96, '2–20'],
  ['Dimension', '2x10', 1.5, 9.25, 80, '2–20'],
  ['Dimension', '2x12', 1.5, 11.25, 64, '2–20'],
  ['Timbers', '3x6', 2.5, 5.5, 80, '2–20'],
  ['Timbers', '4x4', 3.5, 3.5, null, '2–20'],
  ['Timbers', '4x6', 3.5, 5.5, null, '2–20'],
];

// Sort keys: "order" = original row order; others are numeric data attributes on each row.
const columns = [
  { key: 'cat', label: 'Category', align: 'left', sort: 'order' },
  { key: 'nom', label: 'Nominal', align: 'right', sort: 'order' },
  { key: 't', label: 'Thickness (in)', align: 'right', sort: 't' },
  { key: 'w', label: 'Width (in)', align: 'right', sort: 'w' },
  { key: 'pack', label: 'Std. pack (pcs)', align: 'right', sort: 'pack' },
  { key: 'len', label: 'Lengths (ft)', align: 'right', sort: 'order' },
];

const grades = [
  ['Board grades', 'C&Btr, D, No. 2, No. 3, No. 4'],
  ['Dimension grades', 'MSR, Dense Select Structural, Select Structural, No. 1 – No. 4'],
  ['Timber grades', 'No. 1, No. 2, No. 3 & No. 4 · sizes to 12x12'],
];
---

<BaseLayout
  title="Southern Yellow Pine Products | Timber Resources"
  description="Southern Yellow Pine boards, dimension lumber and timbers for pallet, truss, dunnage, playground and landscape customers — sourced to your specification and quoted delivered."
  current="products"
  shareImage={pineStand}
>
  <section class="page-intro">
    <div class="container intro-split">
      <div class="intro-split__copy">
        <span class="overline overline--primary">Products &amp; customers</span>
        <h1>Southern Yellow Pine, sourced to your specification.</h1>
        <p class="lead">
          Tell us the dimensions, lengths, grade, quantity and treatment you need. We source through established mills
          and quote it delivered to your plant.
        </p>
      </div>
      <Photo
        src={pineStand}
        alt="Rows of tall southern pine trees in a managed forest stand"
        ratio="4 / 5"
        sizes="(max-width: 760px) 100vw, 440px"
        priority
        class="intro-split__photo"
      />
    </div>
  </section>

  <section class="products">
    <div class="container stack" style="--stack-gap: 16px">
      <article class="card card--elevated">
        <div class="pallet__head">
          <div class="pallet__title">
            <h2>Pallet, crate &amp; industrial packaging</h2>
            <span class="chip chip--status">Core business</span>
          </div>
          <a href="/quote/" class="btn btn--primary btn--sm">Quote pallet lumber</a>
        </div>
        <Photo
          src={pallets}
          alt="Newly built wooden pallets stacked and ready for distribution"
          ratio="auto"
          sizes="(max-width: 1200px) 100vw, 1152px"
          maxWidth={1600}
          bare
          class="pallet__photo"
        />
        <div class="pallet__body">
          <div class="pallet__text">
            <p>
              We supply pallet and crate manufacturers, pallet recyclers and industrial packaging plants that buy lumber
              week after week — and we’re set up for those repeat truckloads.
            </p>
          </div>
          <dl class="kv pallet__specs">
            {
              palletSpecs.map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </article>

      <div class="segments">
        <article class="card segment">
          <h2>Truss manufacturers</h2>
          <p>
            Structural SYP dimension lumber for truss and component plants. Send sizes, lengths and grade — including MSR
            and No. 1 / No. 2.
          </p>
        </article>
        <article class="card segment">
          <h2>Dunnage</h2>
          <p>Economical boards, timbers and landscape timbers for blocking, bracing and protecting loads in transit.</p>
        </article>
        <article class="card segment">
          <h2>Playground manufacturers</h2>
          <p>High-grade lumber remanufactured to your requirements, then pressure treated.</p>
          <div class="segment__chips">
            <span class="chip mono">4x4 · 2x4 · 1x4</span>
            <span class="chip">No knots or wane</span>
            <span class="chip">Smooth edges</span>
            <span class="chip">Pressure treated</span>
          </div>
        </article>
        <article class="card segment segment--wide">
          <Photo
            src={liftTruck}
            alt="Lift truck carrying a stack of green lumber across a mill yard"
            ratio="16 / 9"
            sizes="(max-width: 760px) 100vw, 480px"
            class="segment__photo"
          />
          <div class="segment__body">
            <h2>Landscape timbers</h2>
            <p>
              Green, untreated timbers direct from plywood mills — bought by pallet graders, dunnage users and reman
              plants, or remanufactured by us into pallet boards.
            </p>
            <p class="segment__note">Heavy green product: offered for Southern US delivery.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="reference">
    <div class="container stack" style="--stack-gap: 12px">
      <div class="reference__head">
        <div class="section-head" style="gap: 6px">
          <span class="overline">Reference</span>
          <h2 class="reference__title">Common SYP sizes</h2>
        </div>
        <span class="reference__hint">Actual dressed dimensions in inches. Select a column header to sort.</span>
      </div>

      <div class="card sizes-wrap">
        <table class="sizes" data-sortable>
          <thead>
            <tr>
              {
                columns.map((c, i) => (
                  <th scope="col" aria-sort={i === 0 ? 'ascending' : 'none'} class={`a-${c.align}`}>
                    <button type="button" data-col={c.key} data-sort={c.sort}>
                      {c.label}{' '}
                      <span aria-hidden="true" class="sizes__arrow">
                        {i === 0 ? '▲' : '↕'}
                      </span>
                    </button>
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              sizes.map(([cat, nom, t, w, pack, len], i) => (
                <tr data-order={i} data-cat={cat} data-t={t} data-w={w} data-pack={pack ?? ''}>
                  <th scope="row">{cat}</th>
                  <td>{nom}</td>
                  <td>{t.toFixed(3)}</td>
                  <td>{w.toFixed(3)}</td>
                  <td>{pack == null ? '—' : nom === '2x4' ? '192 / 208' : pack}</td>
                  <td>{len}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="card cell-grid grades" style="--cell-min: 300px">
        {
          grades.map(([k, v]) => (
            <div>
              <span class="grades__label">{k}</span>
              <span>{v}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    title="Need something else in Southern Yellow Pine?"
    text="Send your material list. If a different option offers better value, we’ll present it — changes only with your approval."
  >
    <a href="/quote/" class="btn btn--inverse">Send your material list</a>
  </CtaBand>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLTableElement>('table[data-sortable]').forEach((table) => {
    const tbody = table.tBodies[0];
    const headers = Array.from(table.querySelectorAll<HTMLTableCellElement>('thead th'));
    let activeCol = 'cat';
    let dir = 1;

    const value = (row: HTMLTableRowElement, sort: string, col: string): number | string | null => {
      if (col === 'cat') return `${row.dataset.cat}${(Number(row.dataset.order) / 100).toFixed(2)}`;
      const raw = row.dataset[sort];
      return raw === '' || raw == null ? null : Number(raw);
    };

    headers.forEach((th) => {
      const btn = th.querySelector('button');
      if (!btn) return;
      btn.addEventListener('click', () => {
        const col = btn.dataset.col!;
        const sort = btn.dataset.sort!;
        dir = col === activeCol ? -dir : 1;
        activeCol = col;

        const rows = Array.from(tbody.rows);
        rows.sort((a, b) => {
          const x = value(a, sort, col);
          const y = value(b, sort, col);
          // Empty values always sink to the bottom.
          if (x == null) return 1;
          if (y == null) return -1;
          return (x < y ? -1 : x > y ? 1 : 0) * dir;
        });
        rows.forEach((r) => tbody.appendChild(r));

        headers.forEach((h) => {
          const b = h.querySelector('button')!;
          const active = b.dataset.col === activeCol;
          h.setAttribute('aria-sort', active ? (dir === 1 ? 'ascending' : 'descending') : 'none');
          b.classList.toggle('is-active', active);
          b.querySelector('.sizes__arrow')!.textContent = active ? (dir === 1 ? '▲' : '▼') : '↕';
        });
      });
    });

    headers[0]?.querySelector('button')?.classList.add('is-active');
  });
</script>

<style>
  .products {
    padding: 48px 0 24px;
  }

  /* Pallet feature card */
  .pallet__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--c-border);
  }
  .pallet__title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .pallet__title h2 {
    font-size: 24px;
  }
  .pallet__title .chip {
    align-self: center;
  }
  .pallet__body {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
  }
  .pallet__text {
    padding: 20px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--c-ink-2);
    border-right: 1px solid var(--c-border);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  article :global(.pallet__photo) {
    height: 220px;
    border-bottom: 1px solid var(--c-border) !important;
  }

  /* Intro with photo */
  .intro-split {
    display: grid !important;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 32px 48px;
    align-items: center;
  }
  .intro-split__copy {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  @media (max-width: 760px) {
    .intro-split {
      grid-template-columns: 1fr;
    }
    .page-intro :global(.intro-split__photo) {
      aspect-ratio: 3 / 2 !important;
    }
  }

  /*
   * An oversized headline, and a tall photo that sits
   * on the band's bottom rule instead of floating in the middle.
   */
  .page-intro h1 {
    font-size: clamp(36px, 5.4vw, 68px);
    line-height: 1.04;
    letter-spacing: -0.01em;
    max-width: none;
  }
  @media (min-width: 761px) {
    .intro-split {
      grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
      gap: 32px 64px;
      align-items: end;
      padding-top: 72px !important;
    }
    .intro-split__copy {
      padding-bottom: 16px;
    }
    .page-intro :global(.intro-split__photo) {
      margin-bottom: -48px;
      border-bottom: 0;
      border-radius: var(--r-md) var(--r-md) 0 0;
    }
  }

  /* Full-width segment card with photo */
  .segment.segment--wide {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: 24px;
    align-items: center;
  }
  .segment__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  @media (max-width: 760px) {
    .segment.segment--wide {
      grid-template-columns: 1fr;
    }
  }
  .pallet__specs dt {
    flex: 0 0 140px;
  }
  /* Design alternates from the 2nd row: white, tint, white, white */
  .pallet__specs > div:nth-child(even) {
    background: transparent;
  }
  .pallet__specs > div:nth-child(2) {
    background: var(--c-surface-alt);
  }

  /* Segment cards */
  .segments {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
    gap: 16px;
  }
  .segment {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .segment:hover {
    border-color: var(--c-border-strong);
  }
  .segment h2 {
    font-size: 20px;
  }
  .segment p {
    font-size: 14px;
    line-height: 1.55;
    color: var(--c-ink-2);
  }
  .segment .segment__note {
    font-size: 12px;
    line-height: 1.4;
    color: var(--c-steel);
  }
  .segment__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-top: 4px;
  }
  .segment__chips .chip {
    padding: 4px 8px;
  }

  /* Reference table */
  .reference {
    padding: 32px 0 64px;
  }
  .reference__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
  }
  .reference__title {
    font-size: 24px;
  }
  .reference__hint {
    font-size: 13px;
    color: var(--c-steel);
  }
  .sizes-wrap {
    overflow: auto;
    max-height: 560px;
  }
  .sizes {
    width: 100%;
    min-width: 760px;
    border-collapse: collapse;
    font-size: 13px;
  }
  .sizes thead th {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--c-surface-alt);
    border-bottom: 1px solid var(--c-border-strong);
    padding: 0;
  }
  .sizes thead .a-left,
  .sizes thead .a-left button {
    text-align: left;
  }
  .sizes thead .a-right,
  .sizes thead .a-right button {
    text-align: right;
  }
  .sizes thead button {
    width: 100%;
    min-height: 44px;
    padding: 0 12px;
    border: 0;
    background: transparent;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    color: var(--c-steel);
  }
  .sizes thead button:hover,
  .sizes thead button.is-active {
    color: var(--c-ink);
  }
  .sizes__arrow {
    font-family: var(--f-mono);
    color: var(--c-primary);
  }
  .sizes tbody tr {
    border-bottom: 1px solid var(--c-border);
  }
  .sizes tbody tr:nth-child(even) {
    background: var(--c-surface-sunk);
  }
  .sizes tbody tr:hover {
    background: var(--c-border);
  }
  .sizes tbody th {
    text-align: left;
    padding: 8px 12px;
    font-weight: 500;
    white-space: nowrap;
  }
  .sizes tbody td {
    padding: 8px 12px;
    font-family: var(--f-mono);
    text-align: right;
  }

  .grades {
    margin-top: 12px;
  }
  .grades > div {
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 14px;
  }
  .grades__label {
    font-size: 12px;
    font-weight: 500;
    color: var(--c-steel);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  @media (max-width: 720px) {
    .pallet__text {
      border-right: 0;
      border-bottom: 1px solid var(--c-border);
    }
  }
</style>
