---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import GrainRings from '../components/GrainRings.astro';
import pineStand from '../assets/images/pine-stand.webp';
import pallets from '../assets/images/pallets.webp';
import liftTruck from '../assets/images/lift-truck-green-lumber.webp';

const palletItems = [
  ['Boards', '1x4 through 1x12, cut-to-length available'],
  ['Dimension & cants', '2x4 through 2x12, low-grade and industrial'],
  ['Remanufactured boards', 'resawn from green plywood-mill timbers'],
  ['Processing', 'resawing, cut-to-length, banding groove, S4S'],
  ['Recurring supply', 'same spec, reordered as you need it'],
];

const playgroundSpecs = ['4x4, 2x4 and 1x4 — other sizes on request', 'Free of knots and wane', 'Smooth, eased edges', 'Pressure treated'];

// [product, nominal sizes (actual), lengths, grades]
const sizes = [
  ['Boards', '1x4 (¾ x 3½) to 1x12 (¾ x 11¼)', '2′–16′, 2′ steps', 'C&Btr, D, No. 2, No. 3, No. 4'],
  [
    'Dimension',
    '2x4 (1½ x 3½) to 2x12 (1½ x 11¼)',
    '2′–20′, 2′ steps',
    'MSR, Dense Select Structural, Select Structural, No. 1–No. 4',
  ],
  ['Timbers', '3x6 to 12x12', '2′–20′, 2′ steps', 'No. 1, No. 2, No. 3 & No. 4'],
];
---

<BaseLayout
  title="Southern Yellow Pine Products | Timber Resources"
  description="Southern Yellow Pine boards, dimension lumber and timbers for pallet, truss, dunnage, playground and landscape customers — sourced to your specification and quoted delivered."
  current="products"
  shareImage={pineStand}
>
  <!-- Intro -->
  <section class="intro">
    <GrainRings class="intro__grain" rings={15} seed={3} />
    <div class="container intro__grid">
      <div class="intro__copy">
        <p class="eyebrow eyebrow--amber">Products &amp; customers</p>
        <h1>Southern Yellow Pine, sourced to your specification.</h1>
        <p class="intro__lead">
          Tell us the dimensions, lengths, grade, quantity and treatment you need. We source through established mills
          and quote it delivered to your plant.
        </p>
      </div>
      <Photo
        src={pineStand}
        alt="Rows of tall southern pine trees in a managed forest stand"
        ratio="4 / 3"
        sizes="(max-width: 960px) 100vw, 548px"
        priority
        class="intro__photo"
      />
    </div>
  </section>

  <section class="products">
    <div class="container products__inner">
      <!-- Core business -->
      <article class="card pallet" data-reveal>
        <Photo
          src={pallets}
          alt="Newly built wooden pallets stacked and ready for distribution"
          ratio="auto"
          sizes="(max-width: 1248px) 100vw, 1152px"
          maxWidth={1600}
          bare
          class="pallet__photo"
        />
        <div class="pallet__body">
          <div class="pallet__copy">
            <span class="tag">Our core business</span>
            <h2>Pallet, crate &amp; industrial packaging lumber</h2>
            <p>
              Keep your production lines moving. We supply pallet and crate manufacturers, pallet recyclers and
              industrial packaging plants that buy lumber week after week — and we’re built for those repeat truckloads.
            </p>
            <a href="/quote/" class="btn btn--amber pallet__cta">Quote pallet lumber</a>
          </div>
          <ul class="pallet__list">
            {
              palletItems.map(([k, v]) => (
                <li>
                  <strong>{k}</strong> — {v}
                </li>
              ))
            }
          </ul>
        </div>
      </article>

      <!-- Other customers -->
      <div class="segments">
        <article class="card segment" data-reveal style="--reveal-i: 0">
          <h2>Truss manufacturers</h2>
          <p>
            Structural Southern Yellow Pine dimension lumber for truss and component plants. Send your sizes, lengths and
            grade — including MSR and No. 1/No. 2 — and we’ll quote it delivered.
          </p>
        </article>
        <article class="card segment" data-reveal style="--reveal-i: 1">
          <h2>Dunnage</h2>
          <p>
            Economical boards, timbers and landscape timbers for blocking, bracing and protecting loads in transit. Ask
            about green material for cost-conscious dunnage programs.
          </p>
        </article>
        <article class="card segment" data-reveal style="--reveal-i: 2">
          <h2>Playground manufacturers</h2>
          <p>
            High-grade lumber for play structures. We remanufacture it to your requirements and send it for pressure
            treatment.
          </p>
          <ul class="segment__specs">
            {playgroundSpecs.map((s) => <li>{s}</li>)}
          </ul>
        </article>
        <article class="card segment segment--wide" data-reveal>
          <Photo
            src={liftTruck}
            alt="Lift truck carrying a stack of green lumber across a mill yard"
            ratio="auto"
            sizes="(max-width: 760px) 100vw, 576px"
            bare
            class="segment__photo"
          />
          <div class="segment__body">
            <h2>Landscape timbers</h2>
            <p>
              Green, untreated timbers that come directly from plywood mills, bought by pallet grading companies, dunnage
              users and remanufacturing plants. We also remanufacture them into boards for pallet manufacturers.
            </p>
            <p class="segment__note">
              Because green material is heavy, this product is offered to buyers in the Southern United States.
            </p>
          </div>
        </article>
      </div>

      <!-- Something else -->
      <article class="else" data-reveal>
        <div class="else__copy">
          <h2>Something else in Southern Yellow Pine?</h2>
          <p>
            Send your material list. We’ll tell you whether we can source it and what we need to quote it accurately. If a
            different option offers better value, we’ll present it — any change is subject to your approval.
          </p>
        </div>
        <a href="/quote/" class="btn btn--forest">Send your material list</a>
      </article>
    </div>
  </section>

  <!-- Reference table -->
  <section class="reference" aria-labelledby="ref-h">
    <div class="container reference__inner" data-reveal>
      <div class="section-head">
        <p class="eyebrow">Reference</p>
        <h2 id="ref-h" class="h2">Common SYP sizes &amp; grades</h2>
        <p class="reference__lead">
          Nominal sizes with actual dressed dimensions. Full truckloads are our focus; partial loads may be possible
          depending on material and destination.
        </p>
      </div>
      <span class="ruler reference__ruler" aria-hidden="true"></span>
      <div class="card table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Product</th>
              <th scope="col">Nominal sizes (actual)</th>
              <th scope="col">Lengths</th>
              <th scope="col">Grades</th>
            </tr>
          </thead>
          <tbody>
            {
              sizes.map(([product, nominal, lengths, grades]) => (
                <tr>
                  <th scope="row">{product}</th>
                  <td>{nominal}</td>
                  <td>{lengths}</td>
                  <td>{grades}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Intro */
  .intro {
    position: relative;
    overflow: hidden;
    background: var(--c-forest);
    color: var(--c-on-forest);
  }
  /* End-grain rings cropped off the top-left corner, above the eyebrow */
  .intro :global(.intro__grain) {
    width: clamp(480px, 52vw, 760px);
    left: clamp(-380px, -22vw, -180px);
    top: clamp(-420px, -24vw, -220px);
    color: var(--c-forest-line);
  }
  .intro__grid {
    position: relative;
    padding-top: clamp(56px, 7vw, 88px);
    padding-bottom: clamp(56px, 7vw, 88px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 40px 56px;
    align-items: center;
  }
  .intro__copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .intro h1 {
    font-size: clamp(36px, 4.6vw, 54px);
    line-height: 1.06;
    font-weight: 800;
    letter-spacing: -0.02em;
    max-width: 820px;
  }
  .intro__lead {
    font-size: 19px;
    line-height: 1.6;
    color: var(--c-on-forest-2);
    max-width: 680px;
  }
  .intro :global(.intro__photo) {
    box-shadow: var(--shadow-photo);
  }

  /* Product cards */
  .products {
    padding: clamp(56px, 7vw, 88px) 0 40px;
  }
  .products__inner {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .pallet {
    overflow: hidden;
  }
  .pallet :global(.pallet__photo) {
    height: clamp(200px, 24vw, 300px);
  }
  .pallet__body {
    padding: clamp(24px, 4vw, 40px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 40px;
  }
  .pallet__copy {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .tag {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-rust);
  }
  .pallet h2 {
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1.12;
    font-weight: 800;
  }
  .pallet p {
    font-size: 17px;
    line-height: 1.65;
    color: var(--c-body);
  }
  .pallet__cta {
    align-self: flex-start;
    margin-top: 8px;
  }
  .pallet__list {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 16px;
  }
  .pallet__list li {
    padding: 14px 0;
    border-bottom: 1px solid var(--c-line-soft);
  }
  .pallet__list li:last-child {
    border-bottom: 0;
  }

  .segments {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 28px;
  }
  .segment {
    padding: 36px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .segment h2 {
    font-size: 26px;
    font-weight: 800;
  }
  .segment p {
    font-size: 16px;
    line-height: 1.65;
    color: var(--c-body);
  }
  .segment__specs {
    margin: 0;
    padding-left: 20px;
    font-size: 16px;
    line-height: 1.8;
    color: var(--c-ink-2);
  }
  .segment--wide {
    grid-column: 1 / -1;
    padding: 0;
    overflow: hidden;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 0;
  }
  .segment--wide :global(.segment__photo) {
    height: 100%;
    min-height: 240px;
  }
  .segment__body {
    padding: 36px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    justify-content: center;
  }
  .segment p.segment__note {
    font-size: 14px;
    line-height: 1.6;
    color: var(--c-muted);
  }

  .else {
    background: var(--c-sand);
    border-radius: var(--r-panel);
    padding: 36px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }
  .else__copy {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 720px;
  }
  .else h2 {
    font-size: 26px;
    font-weight: 800;
  }
  .else p {
    font-size: 16px;
    line-height: 1.65;
    color: var(--c-body);
  }

  /* Reference table */
  .reference {
    padding: 56px 0 96px;
  }
  .reference__inner {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .reference__ruler {
    margin-bottom: -18px; /* sits just above the table, inside the section gap */
  }
  .reference__lead {
    font-size: 16px;
    line-height: 1.6;
    color: var(--c-body);
  }
  .table-wrap {
    overflow-x: auto;
  }
  table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    font-size: 15px;
    text-align: left;
  }
  thead tr {
    background: var(--c-forest);
    color: var(--c-on-forest);
  }
  th,
  td {
    padding: 16px 20px;
  }
  thead th,
  tbody th {
    font-weight: 600;
  }
  td {
    color: var(--c-ink-2);
  }
  tbody tr {
    border-bottom: 1px solid var(--c-line-soft);
  }
  tbody tr:last-child {
    border-bottom: 0;
  }
</style>
