---
import { site } from '../data/site';

interface Props {
  /** "full" = four-column footer (home); "compact" = one line (inner pages). */
  variant?: 'full' | 'compact';
}

const { variant = 'compact' } = Astro.props;
const year = new Date().getFullYear();
---

<footer class:list={['footer', `footer--${variant}`]}>
  {
    variant === 'full' ? (
      <>
        <div class="container footer__grid">
          <div class="footer__col">
            <span class="footer__brand">{site.name}</span>
            <span>{site.description}</span>
          </div>
          <div class="footer__col">
            <span class="footer__label">Contact</span>
            <a href={site.phoneHref} class="mono">{site.phone}</a>
            <span class="mono">Fax {site.fax}</span>
            <span>{site.email}</span>
          </div>
          <div class="footer__col">
            <span class="footer__label">Pages</span>
            <a href="/products/">Products</a>
            <a href="/#how">How we work</a>
            <a href="/quote/">Request a quote</a>
          </div>
          <div class="footer__col">
            <span class="footer__label">Locations</span>
            {site.locations.map((l) => <span>{l}</span>)}
          </div>
        </div>
        <div class="container">
          <div class="footer__legal">© {year} {site.name}</div>
        </div>
      </>
    ) : (
      <div class="container footer__row">
        <span class="footer__brand">{site.name}</span>
        <span class="mono">
          <a href={site.phoneHref}>{site.phone}</a> · Fax {site.fax} · {site.email}
        </span>
      </div>
    )
  }
</footer>

<style>
  .footer {
    background: var(--c-dark);
    color: var(--c-dark-text);
    font-size: 14px;
  }
  .footer a {
    color: var(--c-dark-text);
  }
  .footer a:hover {
    color: #fff;
  }
  .footer--full {
    padding: 40px 0;
    line-height: 1.6;
  }
  .footer--compact {
    padding: 32px 0;
  }
  .footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
  }
  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .footer__col:first-child {
    gap: 6px;
  }
  .footer__brand {
    font-family: var(--f-head);
    font-weight: 700;
    font-size: 18px;
    color: #fff;
  }
  .footer__label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-muted);
  }
  .footer__legal {
    margin-top: 32px;
    padding-top: 16px;
    border-top: 1px solid var(--c-dark-line);
    font-size: 12px;
    color: var(--c-muted);
  }
  .footer__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
  }
</style>
