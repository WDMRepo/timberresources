---
interface Props {
  title: string;
  text: string;
  /** Larger padding/heading (home page). */
  size?: 'md' | 'lg';
}

const { title, text, size = 'md' } = Astro.props;
---

<section class:list={['cta', `cta--${size}`]}>
  <div class="container cta__inner">
    <div class="cta__copy">
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta__actions">
      <slot />
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--c-brand);
    color: #fff;
  }
  .cta__inner {
    padding-top: 40px;
    padding-bottom: 40px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .cta--lg .cta__inner {
    padding-top: 48px;
    padding-bottom: 48px;
    gap: 24px;
  }
  .cta__copy {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 680px;
  }
  .cta h2 {
    font-size: 24px;
    line-height: 1.2;
  }
  .cta--lg h2 {
    font-size: 30px;
  }
  .cta p {
    font-size: 15px;
    line-height: 1.5;
    color: var(--c-primary-on);
  }
  .cta--lg p {
    font-size: 16px;
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
</style>
