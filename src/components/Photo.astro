---
/**
 * Responsive photo. Wraps astro:assets <Image> so every photo gets resized
 * WebP/JPEG variants and a `sizes` hint, capped at `maxWidth`.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** CSS aspect-ratio, e.g. "16 / 10". Use "auto" when the height is set in CSS. */
  ratio?: string;
  sizes?: string;
  /** Load immediately (above-the-fold images). */
  priority?: boolean;
  /** Drop the rounded corners (photos inside cards or full-bleed strips). */
  bare?: boolean;
  /** Largest width generated, in px. */
  maxWidth?: number;
  class?: string;
}

const {
  src,
  alt,
  ratio = '3 / 2',
  sizes = '(max-width: 720px) 100vw, 600px',
  priority = false,
  bare = false,
  maxWidth = 1200,
  class: className,
} = Astro.props;

const cap = Math.min(maxWidth, src.width);
const widths = [480, 800, 1200, 1600, 2400].filter((w) => w < cap).concat(cap);
const height = Math.round((cap / src.width) * src.height);
---

<Image
  src={src}
  alt={alt}
  width={cap}
  height={height}
  widths={widths}
  sizes={sizes}
  quality={78}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  class:list={['photo', { 'photo--bare': bare }, className]}
  style={`aspect-ratio: ${ratio}`}
/>

<style>
  .photo {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: var(--r-img);
  }
  .photo--bare {
    border-radius: 0;
  }
</style>
