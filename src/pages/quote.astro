---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import GrainRings from '../components/GrainRings.astro';

const faqs = [
  [
    'Do you sell partial loads?',
    'Full truckloads are our focus. Partial loads may be possible depending on the product, destination and freight options.',
  ],
  [
    'How do credit and terms work?',
    'Our receivables are credit-insured. We request a credit limit for your account through our insurer, and once it’s approved we extend that line to you. Standard terms are 1% 10 days — a 1% discount on the lumber portion of the invoice (not freight) when paid within 10 days.',
  ],
  [
    'Where do you deliver?',
    'Our core market is the Southeast, and we serve customers in other states including Texas and Kansas. Heavy green products are best suited to Southern destinations.',
  ],
  [
    'Who arranges trucking?',
    'It depends on the order. Some mills ship directly; otherwise we coordinate through our trucking contacts. Freight is included in your delivered price.',
  ],
  [
    'Can you handle recurring orders?',
    'Yes — many customers reorder the same material regularly. Availability and pricing are checked for each load.',
  ],
  [
    'What if there’s a problem with a load?',
    'Call us. We’ll review the issue with you and the parties involved and stay with it until it’s resolved.',
  ],
];
---

<BaseLayout
  title="Request a Delivered Lumber Quote | Timber Resources"
  description="Request a delivered Southern Yellow Pine lumber quote. Send your specs or material list — quotes are often ready the same day. No purchase order needed."
  showHeaderCta={false}
>
  <section class="quote">
    <div class="container quote__grid">
      <div class="quote__main">
        <div class="quote__head">
          <p class="eyebrow">Request a quote</p>
          <h1>Get a delivered lumber quote.</h1>
          <p class="lead">
            Tell us what you need and where it’s going. Quotes are often ready the same day; allow two to three days when
            mills take longer to respond. No purchase order needed.
          </p>
        </div>

        <div class="card thanks" data-quote-success hidden tabindex="-1">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#22382D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M8 12l3 3 5-6"></path></svg>
          <h2 role="status">Thanks — we’ve got your request.</h2>
          <p>
            Our team will review the details and contact you with any questions or a quote. Quotes are often available the
            same day; allow two to three days when supplier responses take longer.
          </p>
          <button type="button" class="btn btn--ghost btn--sm" data-quote-reset>Send another request</button>
        </div>

        <form
          class="card form"
          aria-label="Quote request"
          method="post"
          action={site.quoteFormEndpoint || undefined}
          data-endpoint={site.quoteFormEndpoint}
          data-quote-form
        >
          <input type="hidden" name="_subject" value="New delivered quote request — timberresources.net" />
          <div class="honeypot" aria-hidden="true">
            <label>Leave this empty<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
          </div>

          <fieldset>
            <legend>1. Your company &amp; delivery</legend>
            <div class="form__grid">
              <label>Company name *<input type="text" name="company" autocomplete="organization" required /></label>
              <label>Contact name *<input type="text" name="name" autocomplete="name" required /></label>
              <label>Email *<input type="email" name="email" autocomplete="email" required /></label>
              <label>Phone *<input type="tel" name="phone" autocomplete="tel" required /></label>
              <label
                >Delivery city, state &amp; ZIP *<input
                  type="text"
                  name="delivery_location"
                  required
                  placeholder="e.g. Valdosta, GA 31601"
                /></label
              >
              <label
                >Requested delivery timing<input type="text" name="delivery_timing" placeholder="Date, or “flexible”" /></label
              >
            </div>
          </fieldset>

          <fieldset>
            <legend>2. What you need</legend>
            <div class="form__grid">
              <label>
                I’m buying for
                <select name="buying_for">
                  <option>Pallet / crate / packaging</option>
                  <option>Truss manufacturing</option>
                  <option>Dunnage</option>
                  <option>Playground manufacturing</option>
                  <option>Landscape timbers / remanufacturing</option>
                  <option>Other</option>
                </select>
              </label>
              <label
                >Dimensions &amp; lengths<input
                  type="text"
                  name="dimensions_lengths"
                  placeholder="e.g. 1x6 x 40″, 2x4 x 8′"
                /></label
              >
              <label>Grade<input type="text" name="grade" placeholder="e.g. No. 3, MSR 2400" /></label>
              <label>Quantity<input type="text" name="quantity" placeholder="e.g. 2 truckloads / month" /></label>
              <label>
                Treatment
                <select name="treatment">
                  <option>None / green</option>
                  <option>Kiln dried</option>
                  <option>Pressure treated</option>
                  <option>Heat treated (HT)</option>
                  <option>Not sure</option>
                </select>
              </label>
              <label>
                Alternatives acceptable?
                <select name="alternatives">
                  <option>Discuss with me first</option>
                  <option>Yes</option>
                  <option>No</option>
                </select>
              </label>
            </div>
            <label>Notes or special handling<textarea name="notes" rows="4"></textarea></label>
          </fieldset>

          <div class="form__foot">
            <p class="form__error" role="alert" data-quote-error hidden></p>
            <button type="submit" class="btn btn--amber btn--lg" data-quote-submit>Submit quote request</button>
            <span class="form__hint">Have a long material list? Paste it into the notes or email it to <a href={site.emailHref}>{site.email}</a>.</span>
          </div>
        </form>
      </div>

      <aside class="quote__aside">
        <div class="talk">
          <GrainRings class="talk__grain" rings={10} seed={5} />
          <h2>Prefer to talk it through?</h2>
          <p>Call our team directly. New customers often start with a conversation with the owner.</p>
          <a href={site.phoneHref} class="talk__phone tabular">{site.phone}</a>
          <span class="talk__meta">
            Fax {site.fax}<br /><a href={site.emailHref}>{site.email}</a>
          </span>
        </div>

        <div class="card faq" data-reveal>
          <h2>Before your first order</h2>
          {
            faqs.map(([q, a]) => (
              <details>
                <summary>{q}</summary>
                <p>{a}</p>
              </details>
            ))
          }
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  // Quote form → Formspree (fetch, with a plain POST fallback when JS is off).
  const form = document.querySelector<HTMLFormElement>('[data-quote-form]');
  const success = document.querySelector<HTMLElement>('[data-quote-success]');
  const error = document.querySelector<HTMLElement>('[data-quote-error]');
  const submit = document.querySelector<HTMLButtonElement>('[data-quote-submit]');
  const reset = document.querySelector<HTMLButtonElement>('[data-quote-reset]');
  const phone = '(901) 395-4736';

  function showSuccess() {
    if (!form || !success) return;
    form.reset();
    form.hidden = true;
    success.hidden = false;
    success.focus();
    window.scrollTo({ top: success.getBoundingClientRect().top + window.scrollY - 120 });
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity() || !submit || !error) return;
    const endpoint = form.dataset.endpoint;
    if (!endpoint) return showSuccess(); // demo mode: no endpoint configured

    error.hidden = true;
    const label = submit.textContent;
    submit.disabled = true;
    submit.textContent = 'Sending…';
    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (res.ok) {
        showSuccess();
      } else {
        const data = await res.json().catch(() => ({}));
        const msg =
          (data?.errors as { message: string }[] | undefined)?.map((x) => x.message).join(' ') ||
          'Something went wrong sending your request.';
        error.textContent = `${msg} Please try again or call ${phone}.`;
        error.hidden = false;
      }
    } catch {
      error.textContent = `We couldn’t reach the server. Please try again or call ${phone}.`;
      error.hidden = false;
    } finally {
      submit.disabled = false;
      submit.textContent = label;
    }
  });

  reset?.addEventListener('click', () => {
    if (!form || !success) return;
    success.hidden = true;
    form.hidden = false;
  });
</script>

<style>
  .quote {
    padding: 72px 0 96px;
  }
  .quote__grid {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: flex-start;
  }
  .quote__main {
    flex: 999 1 600px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .quote__head {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .quote__head h1 {
    font-size: clamp(34px, 4.4vw, 50px);
    line-height: 1.06;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  /* Success panel */
  .thanks {
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .thanks[hidden] {
    display: none;
  }
  .thanks h2 {
    font-size: 28px;
    font-weight: 800;
  }
  .thanks p {
    font-size: 17px;
    line-height: 1.6;
    color: var(--c-body);
  }
  .thanks .btn {
    align-self: flex-start;
  }

  /* Form */
  .form {
    padding: 36px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .form[hidden] {
    display: none;
  }
  .honeypot {
    position: absolute;
    left: -9999px;
  }
  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
  }
  legend {
    font-family: var(--f-head);
    font-size: 20px;
    font-weight: 700;
    padding: 0;
    margin-bottom: 18px;
  }
  .form__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 18px;
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 14px;
    font-weight: 600;
  }
  input,
  select,
  textarea {
    min-height: 46px;
    padding: 0 14px;
    border: 1px solid var(--c-field-line);
    border-radius: var(--r-btn);
    background: var(--c-field);
    color: var(--c-ink);
    font-weight: 400;
  }
  select {
    padding: 0 12px;
  }
  textarea {
    padding: 12px 14px;
    resize: vertical;
  }
  input,
  select,
  textarea {
    transition:
      border-color var(--t-fast) var(--ease-out),
      background-color var(--t-fast) var(--ease-out),
      box-shadow var(--t-med) var(--ease-out);
  }
  @media (hover: hover) {
    input:hover,
    select:hover,
    textarea:hover {
      border-color: var(--c-hover-line);
    }
  }
  /* Focus: field brightens to white and gets a soft forest ring */
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--c-forest);
    background: var(--c-surface);
    box-shadow: 0 0 0 3px rgba(34, 56, 45, 0.14);
  }
  .form__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }
  .form__error {
    flex-basis: 100%;
    padding: 12px 14px;
    border-radius: var(--r-btn);
    background: #fdecec;
    color: #8a1c1c;
    font-size: 15px;
  }
  .form__error[hidden] {
    display: none;
  }
  .form__hint {
    font-size: 14px;
    color: var(--c-muted);
  }

  /* Aside */
  .quote__aside {
    flex: 1 1 320px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .talk {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--c-forest);
    color: var(--c-on-forest);
    border-radius: var(--r-panel);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .talk :global(.talk__grain) {
    width: 360px;
    right: -170px;
    bottom: -190px;
    color: var(--c-forest-line);
    z-index: -1;
  }
  .talk h2 {
    font-size: 22px;
    font-weight: 700;
  }
  .talk p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--c-on-forest-2);
  }
  .talk__phone {
    align-self: flex-start;
    color: var(--c-on-forest);
    font-family: var(--f-head);
    font-size: 26px;
    font-weight: 700;
    text-decoration: none;
    transition: color var(--t-fast) var(--ease-out);
  }
  .talk__phone:hover {
    color: var(--c-amber);
  }
  .talk__meta {
    font-size: 15px;
    color: var(--c-on-forest-3);
  }
  .talk__meta a {
    color: var(--c-on-forest);
    text-underline-offset: 0.22em;
    text-decoration-thickness: 1px;
  }
  .talk__meta a:hover {
    color: var(--c-amber);
  }
  .faq {
    padding: 8px 28px;
  }
  .faq h2 {
    margin: 20px 0 8px;
    font-size: 22px;
    font-weight: 700;
  }
  details {
    border-bottom: 1px solid var(--c-line-soft);
    padding: 16px 0;
  }
  details:last-child {
    border-bottom: 0;
  }
  summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 16px;
    min-height: 28px;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    transition: color var(--t-fast) var(--ease-out);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  /* Chevron that turns as the answer opens */
  summary::after {
    content: '';
    flex: 0 0 auto;
    width: 7px;
    height: 7px;
    margin-right: 4px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform var(--t-med) var(--ease-out);
  }
  details[open] summary::after {
    transform: translateY(2px) rotate(225deg);
  }
  summary:hover,
  details[open] summary {
    color: var(--c-rust);
  }
  details p {
    margin-top: 10px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--c-body);
  }
</style>
