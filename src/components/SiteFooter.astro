---
import { site } from '../data/site';

interface Props {
  /** "full" = four columns (Home); "compact" = one line (inner pages). */
  variant?: 'full' | 'compact';
}

const { variant = 'compact' } = Astro.props;
const year = new Date().getFullYear();
---

<footer class:list={['footer', `footer--${variant}`]}>
  {
    variant === 'full' ? (
      <div class="container">
        <div class="footer__cols">
          <div class="footer__col">
            <span class="footer__brand">{site.name}</span>
            <span>Southern Yellow Pine lumber broker for manufacturers and commercial buyers.</span>
          </div>
          <div class="footer__col footer__col--tight">
            <span class="footer__head">Contact</span>
            <a href={site.phoneHref}>Phone {site.phone}</a>
            <span>Fax {site.fax}</span>
            <a href={site.emailHref}>{site.email}</a>
          </div>
          <div class="footer__col footer__col--tight">
            <span class="footer__head">Explore</span>
            <a href="/products/">Products &amp; customers</a>
            <a href="/#how">How we work</a>
            <a href="/quote/">Request a quote</a>
          </div>
          <div class="footer__col footer__col--tight">
            <span class="footer__head">Locations</span>
            {site.locations.map((l) => <span>{l}</span>)}
          </div>
        </div>
        <div class="footer__legal">
          © {year} {site.name}. All rights reserved.
        </div>
      </div>
    ) : (
      <div class="container footer__line">
        <span class="footer__brand">{site.name}</span>
        <span>
          <a href={site.phoneHref}>{site.phone}</a> · Fax {site.fax} · <a href={site.emailHref}>{site.email}</a>
        </span>
      </div>
    )
  }
</footer>

<style>
  .footer {
    background: var(--c-dark);
    color: var(--c-on-forest-3);
    font-size: 15px;
    line-height: 1.7;
  }
  .footer a {
    color: var(--c-on-forest-3);
  }
  .footer a:hover {
    color: var(--c-on-forest);
  }
  .footer--full {
    padding: 56px 0 40px;
  }
  .footer--compact {
    padding: 48px 0;
  }
  .footer__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 32px;
  }
  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .footer__col--tight {
    gap: 2px;
  }
  .footer__brand {
    font-family: var(--f-head);
    font-weight: 800;
    font-size: 19px;
    color: var(--c-on-forest);
  }
  .footer__head {
    font-weight: 600;
    color: var(--c-on-forest);
  }
  .footer__legal {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--c-dark-line);
    font-size: 13px;
  }
  .footer__line {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 20px;
  }
</style>
