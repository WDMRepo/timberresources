---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import GrainRings from '../components/GrainRings.astro';
import Photo from '../components/Photo.astro';
import { site } from '../data/site';
import { localBusinessSchema } from '../data/schema';
import heroLumber from '../assets/images/hero-lumber-stack.webp';
import pallets from '../assets/images/pallets.webp';
import loadingTruck from '../assets/images/forklift-loading-truck.webp';
import sawmillLine from '../assets/images/sawmill-line.webp';

// [figure, label]
const stats = [
  ['Since 1981', 'Owner in the lumber industry'],
  ['Est. 2012', 'Family-run brokerage'],
  ['Full truckloads', 'Repeat and one-time orders'],
  ['Often same day', 'Delivered quotes · 2–3 days at most'],
];

const segments = [
  ['Truss manufacturers', 'Structural SYP dimension lumber to your grade and length requirements.'],
  ['Dunnage', 'Economical boards and timbers for blocking, bracing and protecting freight.'],
  ['Playground manufacturers', 'Clear 4x4s, 2x4s and 1x4s — no knots or wane, smooth edges, pressure treated.'],
  ['Landscape timbers & reman', 'Green, untreated timbers from plywood mills — or remanufactured into pallet boards.'],
];

const steps = [
  [
    'Send your requirements',
    'Species, dimensions, lengths, grade, quantity, treatment and delivery ZIP — or paste in your material list.',
  ],
  [
    'We check mills and freight',
    'We contact suitable mills in our network and price trucking to your location — whether the mill ships or we arrange it.',
  ],
  [
    'Review one delivered price',
    'Often the same day. If a better-value option exists we’ll show it — any change only with your approval.',
  ],
  [
    'Track it to arrival',
    'Updates on material readiness, trucking and expected arrival — and a person who stays involved if anything needs attention.',
  ],
];

// Monogram tiles stand in until real headshots arrive.
const team = [
  {
    initials: 'KP',
    tone: 'var(--c-forest)',
    name: 'Ken Proctor',
    role: 'Owner & Sales',
    bio: 'Ken started in the lumber business in 1981 and spent three decades working for sawmills around the country before founding Timber Resources in 2012. New customers usually start with a call to Ken.',
  },
  {
    initials: 'SP',
    tone: 'var(--c-forest-2)',
    name: 'Sam Pratt',
    role: 'Sales · Jacksonville, Florida',
    bio: 'Sam has been in the lumber business for about 40 years, from managing sales at a sawmill to owning a remanufacturing plant and working in wholesale. Sam works out of our Jacksonville, Florida office.',
  },
  {
    initials: 'CP',
    tone: 'var(--c-forest-3)',
    name: 'Chris Proctor',
    role: 'Sales & Accounts',
    bio: 'Chris joined Timber Resources more than five years ago and looks after quotes, orders and customer accounts.',
  },
];

const terms = [
  [
    'Insured credit lines',
    'Our receivables are credit-insured, so qualified customers can be set up on open terms with a limit approved through our insurer.',
  ],
  ['1% 10 days', 'Pay within 10 days and take 1% off the lumber portion of your invoice.'],
  [
    'Serving the South',
    'Our core market is the Southeast, with customers in Texas, Kansas and beyond. Freight is evaluated for every destination.',
  ],
];
---

<BaseLayout
  title="Timber Resources — Southern Yellow Pine Lumber Broker"
  description="Southern Yellow Pine sourcing for manufacturers and commercial buyers. Competitive delivered quotes, truckload supply, and personal order updates."
  footer="full"
  jsonLd={localBusinessSchema}
>
  <!-- Hero -->
  <section class="hero">
    <GrainRings class="hero__grain" rings={16} seed={2} />
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow eyebrow--amber">Southern Yellow Pine lumber broker</p>
        <h1>Truckload lumber for the plants that build pallets, trusses and playgrounds.</h1>
        <p class="hero__lead">
          Send us your specs. We find the right Southern mill, build freight into one delivered price, and keep you
          posted until the truck backs into your dock.
        </p>
        <div class="hero__actions">
          <a href="/quote/" class="btn btn--amber">Request a Delivered Quote</a>
          <a href={site.phoneHref} class="btn btn--line tabular">Call {site.phone}</a>
        </div>
      </div>
      <figure class="hero__figure">
        <Photo
          src={heroLumber}
          alt="Bundles of stacked pine lumber in a lumber yard under a blue sky"
          ratio="5 / 4"
          sizes="(max-width: 900px) 100vw, 572px"
          priority
          class="hero__photo"
        />
        <figcaption>Sourced through established Southern mills</figcaption>
      </figure>
    </div>
    <div class="stats">
      <span class="ruler stats__ruler" aria-hidden="true"></span>
      <dl class="container stats__grid">
        {
          stats.map(([figure, label]) => (
            <div class="stat">
              <dt>{label}</dt>
              <dd>{figure}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Who we supply -->
  <section class="section" aria-labelledby="supply-h">
    <div class="container supply">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Who we supply</p>
        <h2 id="supply-h" class="h2">Lumber for manufacturers who buy by the truckload.</h2>
        <p class="lead">
          Tell us your species, sizes, grade and delivery point. We match your specs to the right mill and quote it
          delivered to your door.
        </p>
      </div>

      <a href="/products/" class="card seg core" data-reveal>
        <Photo
          src={pallets}
          alt="Newly built wooden pallets stacked and ready for distribution"
          ratio="auto"
          sizes="(max-width: 800px) 100vw, 600px"
          bare
          class="core__photo"
        />
        <div class="core__body">
          <span class="core__tag">Our core business</span>
          <h3>Pallet, crate &amp; industrial packaging</h3>
          <p>
            Boards, cants and dimension lumber for pallet and crate plants, pallet recyclers and industrial packaging
            operations — sourced for ongoing production, load after load.
          </p>
          <span class="core__more">See pallet lumber <span class="arrow" aria-hidden="true">→</span></span>
        </div>
      </a>

      <div class="segments">
        {
          segments.map(([title, text], i) => (
            <a href="/products/" class="card seg segment" data-reveal style={`--reveal-i: ${i}`}>
              <h3>{title}</h3>
              <p>{text}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- How we work -->
  <section id="how" class="section how" aria-labelledby="how-h">
    <div class="container how__grid">
      <div class="section-head how__head" data-reveal>
        <p class="eyebrow">How we work</p>
        <h2 id="how-h" class="h2">Know the delivered price. Know what happens next.</h2>
        <p class="lead">
          A lumber order is more than a mill price. Availability, freight and timing all matter — we handle those
          details and keep you informed.
        </p>
        <Photo
          src={loadingTruck}
          alt="Forklift loading bundles of lumber onto a flatbed trailer"
          ratio="16 / 10"
          sizes="(max-width: 900px) 100vw, 548px"
          class="how__photo"
        />
      </div>
      <ol class="steps">
        {
          steps.map(([title, text], i) => (
            <li data-reveal style={`--reveal-i: ${i}`}>
              <span class="steps__num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="section about" aria-labelledby="about-h">
    <div class="container about__inner">
      <div class="about__intro" data-reveal>
        <div class="section-head">
          <p class="eyebrow">About Timber Resources</p>
          <h2 id="about-h" class="h2">Sawmill experience. A family business that stays involved.</h2>
        </div>
        <div class="about__text">
          <p>
            Ken Proctor has worked in the lumber industry since 1981, for sawmills across the country — including a year
            with a spruce manufacturer in British Columbia. He started Timber Resources in 2012 to put that mill-side
            knowledge to work for buyers.
          </p>
          <p>
            Our small team brings more than eight decades of combined experience in sawmilling, remanufacturing and
            wholesale lumber. When you call, you talk to the people sourcing your order.
          </p>
        </div>
      </div>
      <Photo
        src={sawmillLine}
        alt="Pine logs moving along the cutting line inside a sawmill"
        ratio="auto"
        sizes="(max-width: 1248px) 100vw, 1152px"
        maxWidth={1600}
        class="about__photo"
      />
      <ul class="team">
        {
          team.map((p, i) => (
            <li class="person" data-reveal style={`--reveal-i: ${i}`}>
              <div class="person__mono" style={`background: ${p.tone}`} aria-hidden="true">
                {p.initials}
              </div>
              <h3>{p.name}</h3>
              <p class="person__role">{p.role}</p>
              <p class="person__bio">{p.bio}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Terms -->
  <section id="terms" class="terms-section" aria-labelledby="terms-h">
    <div class="container terms__inner" data-reveal>
      <h2 id="terms-h">Account &amp; terms</h2>
      <span class="ruler terms__ruler" aria-hidden="true"></span>
      <dl class="terms">
        {
          terms.map(([t, d]) => (
            <div>
              <dt>{t}</dt>
              <dd>{d}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <CtaBand
    title="Have a material list ready?"
    text="Send it over. Quotes are often ready the same day — allow two to three days when mills take longer to respond. No purchase order needed."
  >
    <a href="/quote/" class="btn btn--amber">Request a Delivered Quote</a>
    <a href={site.phoneHref} class="btn btn--line tabular">{site.phone}</a>
  </CtaBand>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--c-forest);
    color: var(--c-on-forest);
  }
  /* End-grain rings, cropped off the lower-left corner behind the headline */
  .hero :global(.hero__grain) {
    width: clamp(520px, 62vw, 860px);
    left: clamp(-420px, -24vw, -200px);
    bottom: clamp(-460px, -26vw, -240px);
    color: var(--c-forest-line);
    opacity: 0.9;
  }
  .hero__grid,
  .stats {
    position: relative;
  }
  .hero__grid {
    padding-top: clamp(56px, 8vw, 96px);
    padding-bottom: clamp(48px, 7vw, 80px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 56px;
    align-items: center;
  }
  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .hero h1 {
    font-size: clamp(38px, 5.2vw, 60px);
    line-height: 1.04;
    font-weight: 800;
    letter-spacing: -0.025em;
  }
  .hero__lead {
    font-size: 19px;
    line-height: 1.6;
    color: var(--c-on-forest-2);
    max-width: 34em;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 6px;
  }
  .hero__figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .hero__figure :global(.hero__photo) {
    object-position: center 60%;
    box-shadow: var(--shadow-photo);
  }
  .hero__figure figcaption {
    font-size: 13px;
    color: var(--c-on-forest-4);
  }

  /* Stats strip along the bottom of the hero */
  .stats__ruler {
    color: var(--c-forest-line);
  }
  .stats__grid {
    margin-top: 0;
    margin-bottom: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  }
  .stat {
    padding: 26px 24px 26px 0;
    display: flex;
    flex-direction: column-reverse;
    gap: 4px;
  }
  .stat dt {
    font-size: 14px;
    color: var(--c-on-forest-3);
  }
  .stat dd {
    margin: 0;
    font-family: var(--f-head);
    font-size: 30px;
    font-weight: 700;
    color: var(--c-on-forest);
  }

  /* Who we supply */
  .supply {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .core {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
    border-radius: var(--r-card);
    overflow: hidden;
  }
  .core :global(.core__photo) {
    height: 100%;
    min-height: 280px;
  }
  .core__body {
    padding: clamp(28px, 4vw, 44px);
    display: flex;
    flex-direction: column;
    gap: 12px;
    justify-content: center;
  }
  .core__tag {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-rust);
  }
  .core h3 {
    font-size: clamp(24px, 2.6vw, 30px);
    line-height: 1.15;
    font-weight: 700;
  }
  .core p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--c-body);
  }
  .core__more {
    font-weight: 600;
    color: var(--c-rust);
    padding-top: 4px;
  }
  .segments {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: 16px;
  }
  .segment {
    border-radius: var(--r-card);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .segment h3 {
    font-size: 20px;
    font-weight: 700;
  }
  .segment p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--c-body);
  }

  /* How we work */
  .how {
    background: var(--c-sand);
  }
  .how__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 48px 64px;
    align-items: start;
  }
  .how__head :global(.how__photo) {
    margin-top: 12px;
  }
  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }
  .steps li {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 16px;
    padding: 24px 0;
    border-top: 1px solid var(--c-line-strong);
  }
  .steps li:last-child {
    border-bottom: 1px solid var(--c-line-strong);
  }
  .steps__num {
    font-family: var(--f-head);
    font-size: 15px;
    font-weight: 700;
    color: var(--c-rust);
    padding-top: 3px;
  }
  .steps li div {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .steps h3 {
    font-size: 20px;
    font-weight: 700;
  }
  .steps p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--c-body);
  }

  /* About */
  .about {
    background: var(--c-surface);
    border-bottom: 1px solid var(--c-line);
  }
  .about__inner {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .about__intro {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 24px 64px;
    align-items: start;
  }
  .about__text {
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 17px;
    line-height: 1.7;
    color: var(--c-ink-2);
  }
  .about__inner :global(.about__photo) {
    height: clamp(220px, 30vw, 380px);
  }
  .team {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 32px 24px;
  }
  .person {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .person__mono {
    aspect-ratio: 1 / 1;
    max-width: 200px;
    width: 100%;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--f-head);
    font-size: 52px;
    font-weight: 800;
    color: var(--c-amber);
    letter-spacing: -0.02em;
  }
  .person h3 {
    margin-top: 4px;
    font-size: 21px;
    font-weight: 700;
  }
  .person__role {
    font-size: 14px;
    font-weight: 600;
    color: var(--c-rust);
  }
  .person__bio {
    font-size: 15px;
    line-height: 1.6;
    color: var(--c-body);
  }

  /* Terms */
  .terms-section {
    padding: clamp(56px, 7vw, 80px) 0;
  }
  .terms__inner {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .terms__inner h2 {
    font-size: 22px;
    font-weight: 700;
  }
  .terms__ruler {
    color: var(--c-ink);
    margin-bottom: -20px; /* the ticks sit on the top edge of the terms row */
  }
  .terms {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
  }
  .terms div {
    padding: 22px 28px 22px 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .terms dt {
    font-family: var(--f-head);
    font-size: 18px;
    font-weight: 700;
  }
  .terms dd {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--c-body);
  }
</style>
