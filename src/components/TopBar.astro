---
import { site } from '../data/site';
---

<div class="topbar">
  <div class="container topbar__inner">
    <span>{site.topBar}</span>
    <span class="mono">Tel {site.phone} · Fax {site.fax}</span>
  </div>
</div>

<style>
  .topbar {
    background: var(--c-dark);
    color: var(--c-dark-text);
    font-size: 13px;
  }
  .topbar__inner {
    padding-top: 8px;
    padding-bottom: 8px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
  }
</style>
