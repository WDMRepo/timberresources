---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** CSS aspect-ratio for the frame, e.g. "16 / 9". */
  ratio?: string;
  /** Responsive sizes hint for the browser. */
  sizes?: string;
  /** Eager-load above-the-fold images. */
  priority?: boolean;
  /** Drop the border/radius frame (full-bleed bands). */
  bare?: boolean;
  /** Largest width generated (keeps the fallback src from being the full original). */
  maxWidth?: number;
  class?: string;
}

const {
  src,
  alt,
  ratio = '3 / 2',
  sizes = '(max-width: 720px) 100vw, 600px',
  priority = false,
  bare = false,
  maxWidth = 1200,
  class: className,
} = Astro.props;

const cap = Math.min(maxWidth, src.width);
const widths = [480, 800, 1200, 1600, 2400].filter((w) => w < cap).concat(cap);
// Width/height are the fallback <img src> size; keep the original aspect ratio.
const height = Math.round((cap / src.width) * src.height);
---

<Image
  src={src}
  alt={alt}
  width={cap}
  height={height}
  widths={widths}
  sizes={sizes}
  quality={78}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  class:list={['photo', { 'photo--bare': bare }, className]}
  style={`aspect-ratio: ${ratio}`}
/>

<style>
  .photo {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    background: var(--c-surface-sunk);
  }
  .photo--bare {
    border: 0;
    border-radius: 0;
  }
</style>
